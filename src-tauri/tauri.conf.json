{
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "com.isunky.deepseek-harness.client",
  "build": {
    "frontendDist": "../client/tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../client/core-channel.json": "client/core-channel.json",
      "../client/runtime/core-manager.mjs": "client/runtime/core-manager.mjs",
      "../client/runtime/hide-console.cjs": "client/runtime/hide-console.cjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
