{
  "name": "deepseek-harness-client",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight Tauri client build for DeepSeek Harness.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "client:dev": "node scripts/client.mjs dev",
    "client:package:win": "node scripts/client.mjs package win-x64",
    "client:package:mac:arm64": "node scripts/client.mjs package mac-arm64",
    "client:package:mac:x64": "node scripts/client.mjs package mac-x64",
    "client:package:dir": "node scripts/client.mjs package dir",
    "client:core:check": "node scripts/client.mjs core:check",
    "client:core:install": "node scripts/client.mjs core:install",
    "client:update-upstream": "node scripts/client.mjs update-upstream",
    "client:check": "node scripts/client.mjs check",
    "client:version:next": "node scripts/release-version.mjs next",
